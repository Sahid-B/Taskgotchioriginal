{
  "info": {
    "_postman_id": "a1b2c3d4-taskgotchi-postman-collection",
    "name": "Taskgotchi API - Práctica Programación Avanzada",
    "description": "Colección de Postman v2.1 para la verificación del CRUD de Tareas y manejo de respuestas HTTP (200, 201, 204, 400, 404, 405, 409, 422, 500).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Crear Tarea Válida (201 Created)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('Has Location header', function () {",
              "    pm.response.to.have.header('Location');",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test('Contains created ID and title', function () {",
              "    pm.expect(jsonData.id).to.be.a('number');",
              "    pm.expect(jsonData.title).to.eql('Estudiar Examen Final Programación');",
              "});",
              "pm.environment.set('createdTaskId', jsonData.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Estudiar Examen Final Programación\",\n  \"description\": \"Repasar Spring Boot, JPA y Postgres\",\n  \"priority\": \"HIGH\",\n  \"difficulty\": \"HARD\",\n  \"dueDate\": \"2026-11-30T23:59:59\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/tasks",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "tasks"]
        }
      }
    },
    {
      "name": "2. Consultar Tarea Creada (200 OK)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test('Check correct ID retrieved', function () {",
              "    pm.expect(jsonData.id).to.eql(parseInt(pm.environment.get('createdTaskId')));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/tasks/{{createdTaskId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "tasks", "{{createdTaskId}}"]
        }
      }
    },
    {
      "name": "3. Listar Tareas con Paginación y Orden (200 OK)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test('Check pagination response fields', function () {",
              "    pm.expect(jsonData).to.have.property('content');",
              "    pm.expect(jsonData.pageable.pageSize).to.eql(10);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/tasks?page=0&size=10&sort=id,asc",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "tasks"],
          "query": [
            { "key": "page", "value": "0" },
            { "key": "size", "value": "10" },
            { "key": "sort", "value": "id,asc" }
          ]
        }
      }
    },
    {
      "name": "4. Buscar Tarea por Título (200 OK)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test('Finds matching title', function () {",
              "    pm.expect(jsonData.content.length).to.be.above(0);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/tasks?title=Examen",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "tasks"],
          "query": [
            { "key": "title", "value": "Examen" }
          ]
        }
      }
    },
    {
      "name": "5. Actualizar Tarea (200 OK & actualizadoEn)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test('Has updatedAt timestamp', function () {",
              "    pm.expect(jsonData.updatedAt).to.not.be.null;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Estudiar Examen Final Programación Modificado\",\n  \"description\": \"Repasar Spring Boot, JPA, Postgres y Pruebas\",\n  \"priority\": \"HIGH\",\n  \"difficulty\": \"HARD\",\n  \"dueDate\": \"2026-11-30T23:59:59\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/tasks/{{createdTaskId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "tasks", "{{createdTaskId}}"]
        }
      }
    },
    {
      "name": "6. Validación: Campos Obligatorios Vacíos (400 Bad Request)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 400 Bad Request', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test('Contains validation error object', function () {",
              "    pm.expect(jsonData).to.have.property('errors');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"\",\n  \"priority\": null,\n  \"difficulty\": null\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/tasks",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "tasks"]
        }
      }
    },
    {
      "name": "7. JSON Mal Formado o Enum Inválido (400 Bad Request)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 400 Bad Request', function () {",
              "    pm.response.to.have.status(400);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Tarea con Enum Invalido\",\n  \"priority\": \"SUPER_HIGH\",\n  \"difficulty\": \"EXTREME\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/tasks",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "tasks"]
        }
      }
    },
    {
      "name": "8. Identificador Inexistente (404 Not Found)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 404 Not Found', function () {",
              "    pm.response.to.have.status(404);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/tasks/999999",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "tasks", "999999"]
        }
      }
    },
    {
      "name": "9. Conflicto / Duplicado de Usuario (409 Conflict)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 409 Conflict or 422 Unprocessable', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([409, 422]);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"test@example.com\",\n  \"password\": \"123456\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "register"]
        }
      }
    },
    {
      "name": "10. Incumplimiento de Regla de Negocio (422 Unprocessable Entity)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 422 Unprocessable Entity', function () {",
              "    pm.response.to.have.status(422);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/api/v1/pet/feed",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "pet", "feed"]
        }
      }
    },
    {
      "name": "11. Método No Admitido (405 Method Not Allowed)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 405 Method Not Allowed', function () {",
              "    pm.response.to.have.status(405);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "TRACE",
        "url": {
          "raw": "{{baseUrl}}/api/v1/tasks",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "tasks"]
        }
      }
    },
    {
      "name": "12. Eliminar Tarea y Verificar 404 (204 No Content)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 204 No Content', function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/api/v1/tasks/{{createdTaskId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "tasks", "{{createdTaskId}}"]
        }
      }
    }
  ]
}

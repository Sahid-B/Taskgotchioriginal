          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"TSK-BAD\",\n  \"title\": \"Tarea con Enum Invalido\",\n  \"estimatedHours\": 2.0,\n  \"priority\": \"SUPER_HIGH\",\n  \"difficulty\": \"EXTREME\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tasks"]
            }
          }
        },
        {
          "name": "N3: ID no numérico (400 Bad Request)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Contains 6 error keys', function () {",
                  "    pm.expect(jsonData).to.have.all.keys('timestamp', 'status', 'error', 'message', 'path', 'errors');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks/abc-invalid-id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tasks", "abc-invalid-id"]
            }
          }
        },
        {
          "name": "N4: ID inexistente (404 Not Found)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 404 Not Found', function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Contains 6 error keys', function () {",
                  "    pm.expect(jsonData).to.have.all.keys('timestamp', 'status', 'error', 'message', 'path', 'errors');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks/999999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tasks", "999999"]
            }
          }
        },
        {
          "name": "N5: Código de tarea duplicado (409 Conflict)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is exactly 409 Conflict', function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Contains 6 error keys and duplicate message', function () {",
                  "    pm.expect(jsonData).to.have.all.keys('timestamp', 'status', 'error', 'message', 'path', 'errors');",
                  "    pm.expect(jsonData.status).to.eql(409);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"DUP-CODE-01\",\n  \"title\": \"Tarea Original\",\n  \"estimatedHours\": 1.5,\n  \"priority\": \"MEDIUM\",\n  \"difficulty\": \"EASY\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tasks"]
            }
          }
        },
        {
          "name": "N6: Incumplimiento de regla de negocio: Editar tarea completada (422 Unprocessable Entity)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is exactly 422 Unprocessable Entity', function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Contains 6 error keys and business rule message', function () {",
                  "    pm.expect(jsonData).to.have.all.keys('timestamp', 'status', 'error', 'message', 'path', 'errors');",
                  "    pm.expect(jsonData.status).to.eql(422);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"DUP-CODE-01\",\n  \"title\": \"Intento de Editar Tarea Completada\",\n  \"estimatedHours\": 2.0,\n  \"priority\": \"HIGH\",\n  \"difficulty\": \"HARD\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks/{{completedTaskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tasks", "{{completedTaskId}}"]
            }
          }
        },
        {
          "name": "N7: PATCH a /api/v1/tasks/{id} no soportado (405 Method Not Allowed)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 405 Method Not Allowed', function () {",
                  "    pm.response.to.have.status(405);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Contains 6 error keys', function () {",
                  "    pm.expect(jsonData).to.have.all.keys('timestamp', 'status', 'error', 'message', 'path', 'errors');",
                  "    pm.expect(jsonData.status).to.eql(405);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Intento de Patch no permitido\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tasks", "1"]
            }
          }
        }
      ]
    }
  ]

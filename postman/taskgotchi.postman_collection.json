                  "pm.test('Contains 6 error keys and errors list', function () {",
                  "    pm.expect(jsonData).to.have.all.keys('timestamp', 'status', 'error', 'message', 'path', 'errors');",
                  "    pm.expect(jsonData.errors).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }

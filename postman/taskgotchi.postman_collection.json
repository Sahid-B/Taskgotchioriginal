        {
          "name": "N6: Incumplimiento de regla de negocio: Editar tarea completada (422 Unprocessable Entity)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.sendRequest({url: pm.environment.get('baseUrl') + '/api/v1/tasks/' + pm.environment.get('createdTaskId') + '/complete', method: 'PATCH'}, (err, res) => {",
                  "  pm.test('Preparar tarea completada', () => { pm.expect(err).to.eql(null); pm.expect(res.code).to.eql(200); });",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is exactly 422 Unprocessable Entity', function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Contains 6 error keys and business rule message', function () {",
                  "    pm.expect(jsonData).to.have.all.keys('timestamp', 'status', 'error', 'message', 'path', 'errors');",
                  "    pm.expect(jsonData.status).to.eql(422);",
                  "});"
                ],
                "type": "text/javascript"
              }

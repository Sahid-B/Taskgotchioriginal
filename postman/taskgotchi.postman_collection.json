        },
        {
          "name": "E5: Actualizar tarea (200 OK & updatedAt)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Has updatedAt timestamp', function () {",
                  "    pm.expect(jsonData.updatedAt).to.not.be.null;",
                  "    pm.expect(jsonData.title).to.eql('Estudiar Examen Final Programación Modificado');",
                  "});",
                  "pm.execution.setNextRequest('N1: Campos vacíos o fuera de rango (400 Bad Request)');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{taskCode}}\",\n  \"title\": \"Estudiar Examen Final Programación Modificado\",\n  \"description\": \"Repasar Spring Boot, JPA, Postgres y Pruebas\",\n  \"estimatedHours\": 4.0,\n  \"active\": true,\n  \"priority\": \"HIGH\",\n  \"difficulty\": \"HARD\",\n  \"dueDate\": \"2026-11-30T23:59:59\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks/{{createdTaskId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "tasks",
                "{{createdTaskId}}"
              ]
            }
          }
        },
        {
          "name": "E6: Eliminar tarea (204 No Content)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 204 No Content', function () {",
                  "    pm.response.to.have.status(204);",
                  "});",
                  "pm.test('DELETE no devuelve cuerpo', () => pm.expect(pm.response.text()).to.eql(''));",
                  "pm.sendRequest(pm.environment.get('baseUrl') + '/api/v1/tasks/' + pm.environment.get('createdTaskId'), (err, res) => {",
                  "  pm.test('GET posterior devuelve 404', () => { pm.expect(err).to.eql(null); pm.expect(res.code).to.eql(404); });",
                  "});",
                  "pm.execution.setNextRequest(null);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks/{{createdTaskId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "tasks",
                "{{createdTaskId}}"
              ]
            }
          }
        }
      ]
    },

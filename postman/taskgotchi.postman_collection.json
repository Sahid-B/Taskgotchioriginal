{
  "info": {
    "_postman_id": "lab12-taskgotchi-postman-collection",
    "name": "Taskgotchi API - Laboratorio 1.2 Programación Avanzada",
    "description": "Colección de Postman v2.1 organizada en 01-Casos exitosos y 02-Casos negativos para verificar el CRUD de Tareas, búsqueda por título, duplicados 409, reglas de negocio 422 y formato uniforme ApiError de 6 claves.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01-Casos exitosos",
      "item": [
        {
          "name": "E1: Crear tarea válida (201 Created + Location + ID)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Has Location header', function () {",
                  "    pm.response.to.have.header('Location');",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Contains created ID, code, title and estimatedHours', function () {",
                  "    pm.expect(jsonData.id).to.be.a('number');",
                  "    pm.expect(jsonData.code).to.eql('LAB12-TSK1');",
                  "    pm.expect(jsonData.title).to.eql('Estudiar Examen Final Programación');",
                  "    pm.expect(jsonData.estimatedHours).to.eql(3.5);",
                  "    pm.expect(jsonData.active).to.eql(true);",
                  "    pm.expect(jsonData.createdAt).to.not.be.null;",
                  "    pm.expect(jsonData.updatedAt).to.not.be.null;",
                  "});",
                  "pm.environment.set('createdTaskId', jsonData.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"LAB12-TSK1\",\n  \"title\": \"Estudiar Examen Final Programación\",\n  \"description\": \"Repasar Spring Boot, JPA y Postgres\",\n  \"estimatedHours\": 3.5,\n  \"active\": true,\n  \"priority\": \"HIGH\",\n  \"difficulty\": \"HARD\",\n  \"dueDate\": \"2026-11-30T23:59:59\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tasks"]
            }
          }
        },
        {
          "name": "E2: Consultar tarea por ID (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Check correct ID retrieved', function () {",
                  "    pm.expect(jsonData.id).to.eql(parseInt(pm.environment.get('createdTaskId')));",
                  "    pm.expect(jsonData.code).to.eql('LAB12-TSK1');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks/{{createdTaskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tasks", "{{createdTaskId}}"]
            }
          }
        },
        {
          "name": "E3: Listar tareas con paginación y orden (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Check pagination contract with page metadata', function () {",
                  "    pm.expect(jsonData).to.have.property('content');",
                  "    pm.expect(jsonData).to.have.property('page');",
                  "    pm.expect(jsonData.page.number).to.eql(0);",
                  "    pm.expect(jsonData.page.size).to.eql(10);",
                  "    pm.expect(jsonData.page).to.have.property('totalElements');",
                  "    pm.expect(jsonData.page).to.have.property('totalPages');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks?page=0&size=10&sort=id,asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tasks"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" },
                { "key": "sort", "value": "id,asc" }
              ]
            }
          }
        },
        {
          "name": "E4: Buscar por título (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Finds matching title with stable pagination', function () {",
                  "    pm.expect(jsonData.content.length).to.be.above(0);",
                  "    pm.expect(jsonData).to.have.property('page');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks/buscar?title=Examen",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tasks", "buscar"],
              "query": [
                { "key": "title", "value": "Examen" }
              ]
            }
          }
        },
        {
          "name": "E5: Actualizar tarea (200 OK & updatedAt)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Has updatedAt timestamp', function () {",
                  "    pm.expect(jsonData.updatedAt).to.not.be.null;",
                  "    pm.expect(jsonData.title).to.eql('Estudiar Examen Final Programación Modificado');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"LAB12-TSK1\",\n  \"title\": \"Estudiar Examen Final Programación Modificado\",\n  \"description\": \"Repasar Spring Boot, JPA, Postgres y Pruebas\",\n  \"estimatedHours\": 4.0,\n  \"active\": true,\n  \"priority\": \"HIGH\",\n  \"difficulty\": \"HARD\",\n  \"dueDate\": \"2026-11-30T23:59:59\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks/{{createdTaskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tasks", "{{createdTaskId}}"]
            }
          }
        },
        {
          "name": "E6: Eliminar tarea (204 No Content)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 204 No Content', function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks/{{createdTaskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tasks", "{{createdTaskId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "02-Casos negativos",
      "item": [
        {
          "name": "N1: Campos vacíos o fuera de rango (400 Bad Request)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Contains all 6 error keys and errors array', function () {",
                  "    pm.expect(jsonData).to.have.all.keys('timestamp', 'status', 'error', 'message', 'path', 'errors');",
                  "    pm.expect(jsonData.errors).to.be.an('array');",
                  "    pm.expect(jsonData.errors.length).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"\",\n  \"title\": \"\",\n  \"estimatedHours\": -5.0,\n  \"priority\": null,\n  \"difficulty\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tasks"]
            }
          }
        },

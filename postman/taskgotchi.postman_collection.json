{
  "info": {
    "_postman_id": "lab12-taskgotchi-postman-collection",
    "name": "PA-Lab2-Romero-Taskgotchi",
    "description": "Ejecución autónoma: E1-E5, N1-N9, E6. Los scripts controlan el orden para conservar el registro hasta comprobar duplicados, regla de negocio y eliminación. Sin credenciales.",
